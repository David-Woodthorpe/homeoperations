  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.8",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "^24.19.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
