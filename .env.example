# Where the SQLite database and its safety copies live.
# Defaults to ./data beside the app.
DATA_DIR=./data

# Port for the production server (npm start).
PORT=3000

# Bind address. 127.0.0.1 keeps it local; 0.0.0.0 allows LAN access.
HOST=127.0.0.1

# Set to 0 to skip creating the starter sections on a brand-new database.
SEED_SECTIONS=1

# Largest backup/upload request. Backups include manuals and photos.
BODY_SIZE_LIMIT=512M

# Optional API key for /api/v1. Leave empty for local open access.
HOME_OPERATIONS_API_KEY=

# Optional public origin used in llms.txt and API examples, behind a proxy.
PUBLIC_BASE_URL=
